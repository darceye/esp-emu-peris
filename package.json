{
    "name": "esp-emu-peris",
    "version": "0.4.0",
    "private": true,
    "type": "module",
    "description": "Simulated peripherals for the esp-emulator browser (wasm) build",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "serve": "python serve.py",
        "sync": "python sync_www.py",
        "test": "node --test tests/unit/core.test.mjs tests/unit/devices.test.mjs && node tests/m1_smoke.mjs",
        "test:unit": "node --test tests/unit/core.test.mjs tests/unit/devices.test.mjs",
        "test:smoke": "node tests/m1_smoke.mjs",
        "test:m0": "node tests/m0_probe.mjs"
    },
    "devDependencies": {
        "typescript": "5.9"
    }
}
