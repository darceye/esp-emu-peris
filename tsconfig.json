{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "rootDir": "src",
        "outDir": "peris",
        "declaration": true,
        "noEmitOnError": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
